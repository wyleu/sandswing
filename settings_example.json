{
  "wifi": {
    "ssid": "NOWRH81L",
    "password": "*******"
  },
"device": {
  "name": "sandswing-pico",
  "family": "sandswing",
  "role": "swing",
  "location": "workshop"
  },
  "startup": {
    "program": "sandswing.py"
  },
  "pins": {
    "sense": [0, 1, 2, 3],
    "laser_pwm": [8, 9, 10, 11],
    "neopixel": 16,
    "adc_mux": {
    "common": 26,
    "a": 17, "b": 18, "c": 19,
    "inh": null,
    "laser_y": [0, 1, 2, 3, 4, 5, 6, 7]
    },
    "fitted": [0, 1]
  },
  "detection": {
    "num_bells": 4
  },
  "wheel": {
    "rest": "dark",
    "pattern": [2, 1, 4],
    "stand_hand": "after_four",
    "stand_back": "after_two",
    "stand_hold_ms": 350,
    "t_ms": 2500,
    "lost_mult": 1.5
  },
  "output": {
    "enabled_formats": [ "midi", "log", "neopixel","ws"],
    "abell": {
      "enabled": true,
      "com_port": false,
      "uart_id": 0,
      "tx_pin": 0,
      "baud": 9600
    },
   "neopixel": {
      "pin": 16,
      "brightness": 0.4,
      "pixel_order": "GRB",
      "status_color": [0, 80, 0]
    }, 
   "midi": {
      "enabled": true,
      "channel": 0,
      "note_base": 60,
      "velocity": 100,
      "note_duration_ms": 500
    },
    "log": {
      "enabled": true,
      "filename_prefix": "bell_log_",
      "timestamp_format": "%Y%m%d_%H%M%S"
    },
    "output.ws": { "enabled": true },
    "test": {
      "enabled": false,
      "mode": "midi",
      "interval_ms": 5000,
      "midi": {
        "note": 60,
        "velocity": 100,
        "duration_ms": 200
        }
     }
  }
